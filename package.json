{
  "name": "twinscope-website",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation site for TwinScope — static Next.js, deployed to GitHub Pages.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:media": "node scripts/check-media-budget.mjs",
    "check:external": "node scripts/check-no-external.mjs",
    "gate": "npm run typecheck && npm run lint && npm run format:check && npm run check:tokens && npm run build && npm run check:external && npm run check:media",
    "sync:tokens": "node scripts/sync-tokens.mjs"
  },
  "dependencies": {
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@mdx-js/loader": "3.1.1",
    "@types/mdx": "2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.1",
    "typescript": "^5"
  }
}
